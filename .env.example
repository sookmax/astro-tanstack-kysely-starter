# Copy to .env (cp .env.example .env). Read via process.env on the server — never
# import.meta.env, which Vite inlines into the bundle at build time.

# The compose postgres (compose.yaml) publishes on host port 54320.
DATABASE_URL=postgres://postgres:postgres@localhost:54320/postgres

# Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
