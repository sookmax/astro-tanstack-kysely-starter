{
  "name": "astro-tanstack-kysely-starter",
  "version": "0.0.1",
  "private": true,
  "description": "Astro SSR + TanStack Router + TanStack Query + Kysely + better-auth — a fullstack starter (a tiny guestbook)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro sync && astro check",
    "lint": "oxlint && pnpm check",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_BASE_URL=http://localhost:4321 playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:up": "docker compose up -d --wait postgres",
    "db:reset": "docker compose exec postgres sh -c \"dropdb -U postgres --force --if-exists postgres && createdb -U postgres postgres\"",
    "auth:migrate": "auth migrate --config ./src/lib/auth-server.ts",
    "db:migrate": "pnpm auth:migrate --yes && tsx ./src/db/migrate.ts to latest",
    "postdb:migrate": "pnpm db:codegen",
    "db:migrate:deploy": "pnpm auth:migrate --yes && tsx ./src/db/migrate.ts to latest",
    "db:codegen": "kysely-codegen --env-file .env --dialect postgres --out-file ./src/db/schema.ts --include-pattern=\"public.*\"",
    "db:init": "pnpm db:reset && pnpm db:migrate",
    "db:timestamp": "date +\"%Y%m%d%H%M%S\"",
    "image:build": "./build-image.sh",
    "e2e:up": "pnpm image:build && docker compose up -d --wait postgres && pnpm db:init && docker compose --profile test up -d --wait app",
    "e2e:down": "docker compose --profile test down"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "astro": "^7.4.2",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "devalue": "^6.0.3",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@storybook/tanstack-react": "^10.6.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "^1.7.12",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "storybook": "^10.6.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
