---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** keep this page out of search indexes (auth-only pages) */
  noindex?: boolean;
}

const {
  title = "Guestbook",
  description = "An Astro + TanStack Router + TanStack Query + Kysely starter.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <slot />
  </body>
</html>
