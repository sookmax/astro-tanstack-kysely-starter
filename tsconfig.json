{
  // One tsconfig for the whole repo: the app (src), the Storybook config, the
  // root config files and the Playwright specs (/e2e). Playwright reads `paths`
  // from here too, so a spec can `import { EntrySchema } from "@/lib/schemas/…"`.
  //
  // Checked by TWO compilers: `astro check` (TypeScript 6, the devDependency)
  // and oxlint's type-aware pass (oxlint-tsgolint's bundled TypeScript 7). TS 7
  // removed what TS 6 only deprecates (`baseUrl`, `moduleResolution: node`, …),
  // so keep this free of deprecation warnings and both agree.
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", ".storybook/*"],
  "exclude": ["dist", "storybook-static"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // `process`, `Buffer`, … for server code, the db scripts and e2e specs
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
